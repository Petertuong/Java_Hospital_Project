<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.DashboardController"
            style="-fx-padding: 20;">

    <!-- Top Title -->
    <top>
        <Label text="Hospital Dashboard"
               style="-fx-font-size: 24; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Cards -->
    <center>
        <GridPane hgap="20" vgap="20" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints halignment="CENTER"/>
                <ColumnConstraints halignment="CENTER"/>
            </columnConstraints>

            <!-- KPI Cards -->
            <VBox style="-fx-border-color: gray; -fx-border-width: 1; -fx-padding: 20;"
                  GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Total Patients" style="-fx-font-size: 16;"/>
                <Label fx:id="lblPatientsCount"
                       style="-fx-font-size: 28; -fx-font-weight: bold;"/>
            </VBox>

            <VBox style="-fx-border-color: gray; -fx-border-width: 1; -fx-padding: 20;"
                  GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="Active Doctors" style="-fx-font-size: 16;"/>
                <Label fx:id="lblDoctorsCount"
                       style="-fx-font-size: 28; -fx-font-weight: bold;"/>
            </VBox>

            <VBox style="-fx-border-color: gray; -fx-border-width: 1; -fx-padding: 20;"
                  GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="Available Rooms" style="-fx-font-size: 16;"/>
                <Label fx:id="lblAvailableRooms"
                       style="-fx-font-size: 28; -fx-font-weight: bold;"/>
            </VBox>

            <VBox style="-fx-border-color: gray; -fx-border-width: 1; -fx-padding: 20;"
                  GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label text="Today Appointments" style="-fx-font-size: 16;"/>
                <Label fx:id="lblTodayAppointments"
                       style="-fx-font-size: 28; -fx-font-weight: bold;"/>
            </VBox>

        </GridPane>
    </center>

</BorderPane>
