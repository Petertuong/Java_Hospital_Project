<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.PatientController"
      spacing="10"
      fillWidth="true"
      style="-fx-padding: 10;">

    <!-- Title -->
    <Label text="Patient Management"
           style="-fx-font-size: 18; -fx-font-weight: bold;" />

    <!-- Form -->
    <GridPane hgap="10" vgap="8" VBox.vgrow="NEVER">
        <columnConstraints>
            <!-- Cột label (không giãn) -->
            <ColumnConstraints minWidth="100"
                               halignment="RIGHT"
                               hgrow="NEVER"/>

            <!-- Cột input (giãn hết chiều ngang) -->
            <ColumnConstraints minWidth="220"
                               halignment="LEFT"
                               hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Name -->
        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtName"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"
                   maxWidth="Infinity"/>

        <!-- Phone -->
        <Label text="Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPhone"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"
                   maxWidth="Infinity"/>

        <!-- Gender -->
        <Label text="Gender:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbGender"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"
                  GridPane.hgrow="ALWAYS"
                  maxWidth="Infinity"/>

        <!-- SSN -->
        <Label text="SSN:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSSN"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"
                   maxWidth="Infinity"/>

        <!-- Date of Birth -->
        <Label text="Date of Birth:"
               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDOB"
                    GridPane.rowIndex="4" GridPane.columnIndex="1"
                    GridPane.hgrow="ALWAYS"
                    maxWidth="Infinity"/>

        <!-- Address -->
        <Label text="Address:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAddress"
                   GridPane.rowIndex="5" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"
                   maxWidth="Infinity"/>

        <!-- Emergency Contact -->
        <Label text="Emergency Contact:"
               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmergency"
                   GridPane.rowIndex="6" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"
                   maxWidth="Infinity"/>

        <!-- Status -->
        <Label text="Status:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbStatus"
                  GridPane.rowIndex="7" GridPane.columnIndex="1"
                  GridPane.hgrow="ALWAYS"
                  maxWidth="Infinity"/>
    </GridPane>

    <!-- Buttons -->
    <HBox spacing="10">
        <children>
            <Button fx:id="btnAdd"    text="Add"
                    minWidth="80" onAction="#handleAddPatient"/>
            <Button fx:id="btnUpdate" text="Update"
                    minWidth="80" onAction="#handleUpdatePatient"/>
            <Button fx:id="btnDelete" text="Delete"
                    minWidth="80" onAction="#handleDeletePatient"/>
            <Button fx:id="btnClear"  text="Clear"
                    minWidth="80" onAction="#handleClearForm"/>
        </children>
    </HBox>

    <!-- Message label -->
    <Label fx:id="lblMessage" textFill="red" />

    <!-- Table -->
    <TableView fx:id="patientTable"
               VBox.vgrow="ALWAYS"
               prefHeight="200.0">
        <columns>
            <TableColumn fx:id="colName"      text="Name"            prefWidth="150"/>
            <TableColumn fx:id="colPhone"     text="Phone"           prefWidth="110"/>
            <TableColumn fx:id="colGender"    text="Gender"          prefWidth="80"/>
            <TableColumn fx:id="colSSN"       text="SSN"             prefWidth="100"/>
            <TableColumn fx:id="colDOB"       text="Date of Birth"   prefWidth="120"/>
            <TableColumn fx:id="colAddress"   text="Address"         prefWidth="150"/>
            <TableColumn fx:id="colEmergency" text="Emergency"       prefWidth="150"/>
            <TableColumn fx:id="colStatus"    text="Status"          prefWidth="100"/>
        </columns>
    </TableView>

</VBox>
