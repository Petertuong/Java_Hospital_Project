<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.LoginController"
            prefWidth="800" prefHeight="500">

    <!-- nền trắng, có thể đổi màu nếu thích -->
    <stylesheets>
        <!-- nếu có css riêng thì thêm ở đây -->
    </stylesheets>

    <!-- Toàn bộ nội dung login nằm ở giữa -->
    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- Tiêu đề -->
            <VBox spacing="3" alignment="CENTER">
                <Label text="Hospital Management System"
                       style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                <Label text="Login"
                       style="-fx-font-size: 16;"/>
            </VBox>

            <!-- Form login -->
            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="80"/>
                    <ColumnConstraints halignment="LEFT"  minWidth="200" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtUsername"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"
                           maxWidth="250"/>

                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtPassword"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"
                               maxWidth="250"/>
            </GridPane>

            <!-- Hàng nút -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="Login"   onAction="#handleLogin"   minWidth="80"/>
                <Button text="Register" onAction="#handleGoToRegister" minWidth="80"/>
            </HBox>

            <!-- Thông báo lỗi -->
            <Label fx:id="lblError"
                   textFill="red"
                   wrapText="true"
                   maxWidth="300"
                   alignment="CENTER"/>

            <!-- Demo accounts -->
            <VBox alignment="CENTER" spacing="2">
                <Label text="Demo accounts:" style="-fx-font-style: italic; -fx-text-fill: #555;"/>
                <Label text="Admin:  admin / admin123"/>
                <Label text="Staff:  staff / staff123"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
