<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.RegisterController"
            style="-fx-background-color: #f5f5f5;">

    <center>
        <VBox spacing="10" alignment="CENTER"
              BorderPane.alignment="CENTER">
            <children>
                <Label text="Register New Staff Account"
                       style="-fx-font-size: 20; -fx-font-weight: bold;"/>

                <GridPane hgap="10" vgap="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <children>
                        <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtUsername"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <StackPane GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <PasswordField fx:id="txtPassword" visible="true"/>
                            <TextField fx:id="txtPasswordVisible" visible="false"/>
                        </StackPane>

                        <Label text="Confirm Password:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <StackPane GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <PasswordField fx:id="txtConfirmPassword" visible="true"/>
                            <TextField fx:id="txtConfirmPasswordVisible" visible="false"/>
                        </StackPane>

                        <CheckBox fx:id="chkShowPassword" text="Show Password" 
                                  GridPane.rowIndex="3" GridPane.columnIndex="1"
                                  onAction="#handleTogglePasswordVisibility"/>
                    </children>
                </GridPane>

                <HBox spacing="10" alignment="CENTER">
                    <children>
                        <Button text="Register" prefWidth="100"
                                onAction="#handleRegister"/>
                        <Button text="Back to Login" prefWidth="120"
                                onAction="#handleBackToLogin"/>
                    </children>
                </HBox>

                <Label fx:id="lblMessage" textFill="red"/>

                <Label text="Note: Registered users have STAFF role."
                       style="-fx-font-size: 11; -fx-font-style: italic;"/>

            </children>
        </VBox>
    </center>
</BorderPane>
