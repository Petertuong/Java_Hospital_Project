<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.RoomController"
      spacing="10" style="-fx-padding: 10;">

    <Label text="Room Management"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="120" halignment="RIGHT"/>
            <ColumnConstraints minWidth="200" halignment="LEFT"/>
        </columnConstraints>

        <Label text="Room No:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtRoomNo"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Beds Available:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtBedsAvailable"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button fx:id="btnAdd"    text="Add"    minWidth="80"
                onAction="#handleAddRoom"/>
        <Button fx:id="btnUpdate" text="Update" minWidth="80"
                onAction="#handleUpdateRoom"/>
        <Button fx:id="btnDelete" text="Delete" minWidth="80"
                onAction="#handleDeleteRoom"/>
        <Button fx:id="btnClear"  text="Clear"  minWidth="80"
                onAction="#handleClearForm"/>
    </HBox>

    <Label fx:id="lblMessage" textFill="red"/>

    <TableView fx:id="roomTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRoomNo"
                         text="Room No" prefWidth="100"/>
            <TableColumn fx:id="colBedsAvailable"
                         text="Beds Available" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>
